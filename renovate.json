{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["vite", "vitest", "@vitest/**", "@vitejs/**"],
      "groupName": "vitest"
    },
    {
      "matchPackageNames": ["typedoc", "typedoc-plugin-markdown"],
      "groupName": "typedoc"
    }
  ]
}
