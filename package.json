{
  "name": "@pfenerty/tektonic",
  "version": "2.0.0",
  "description": "CDK8s constructs for composing Tekton pipelines as code",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pfenerty/tektonic.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "require": "./dist/lib/testing/index.js",
      "types": "./dist/lib/testing/index.d.ts"
    }
  },
  "bin": {
    "tektonic": "./dist/cli/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js.map",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:scripts": "npm run build && node dist/cli/index.js lint",
    "docs:api": "typedoc",
    "synth": "npx cdk8s synth",
    "import": "npx cdk8s import",
    "prepare": "npm run build"
  },
  "peerDependencies": {},
  "dependencies": {
    "cdk8s": "^2.68.0",
    "constructs": "^10.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "cdk8s-cli": "^2.198.0",
    "ts-node": "^10.9.0",
    "typescript": "~7.0.0",
    "vitest": "^5.0.0",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.0.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "typedoc": {
      "typescript": "$typescript"
    }
  }
}
